/target
.idea/
.claude/
time.ps1

# Voice models, downloaded separately. See docs/voice-setup.md.
# 540 MB of whisper and Kokoro weights, plus the Kokoro voice packs.
/models/
/voices/

# Step-by-step session state, local to one run of the workflow.
.step-session/

# Autopilot decision log, generated by a run. The policy file it reads is
# checked in, but the log of what the answerer decided is local state.
.autopilot/

deepseek_custom.log

# Saved conversations. User data, not source.
.deepseek/

# cargo-mutants scratch output
mutants.out/
mutants.out.old/

# Prose linter waiver sentinel, consumed by the next turn's check.
.prose-skip

# Other workflow session state, local to one run.
.solve-session/
.refactor-session/
.tdd-session/

# scratch state written by the /tighten loop (ledger, quarantine, contract)
.tighten/

# checkpoint state written by gitevo (evo_init)
.evo/

# scanner baseline and work units written by the quality-refactor skill
.quality/

# Scratch scripts the harness agent writes when it works around a missing
# tool. Deleted 2026-08-09 with the Edit tool that removed the need.
fix_*.ps1

# Two zero-byte files that a stuck shell wrote into the repository root.
# Both names are shell redirect targets: the `>` of a JavaScript arrow,
# from an inline `node -e` script that regenerates the quality checklist.
# The quoting broke, the shell read each `=>` as a redirect, and the shell
# then hung for over an hour, rewriting both files. Killed 2026-08-10.
# Kept ignored, since the same script can hang again.
\['
i.metric)

# JVM crash dumps. Written by the JVM into whatever the current directory
# was at crash time, never by anything this repo runs on purpose.
hs_err_pid*.log

# cargo-mutants scoped run logs, e.g. `rtk mutants` output redirected to a
# file at the repo root. Not the mutants.out/ scratch dir above, which is
# the tool's own output directory rather than a redirected log.
mutants_scoped_run.log
